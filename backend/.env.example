JWT_SECRET=<generate-with-secrets.token_urlsafe(48)>
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Известия по имейл. Оставете SMTP_HOST празно, за да са само в приложението.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
